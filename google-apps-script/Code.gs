const ROOT_FOLDER_NAME='AulaMemo AI';
function doGet(){return json_({ok:true,service:'AulaMemo AI Drive Bridge',version:'1.0'})}
function doPost(e){try{const d=JSON.parse(e.postData.contents||'{}');if(d.action!=='saveSessionFicha')return json_({ok:false,error:'Acción no reconocida.'});const root=getFolder_(DriveApp.getRootFolder(),ROOT_FOLDER_NAME),year=Utilities.formatDate(new Date(d.createdAt||new Date()),Session.getScriptTimeZone(),'yyyy'),yf=getFolder_(root,year),title=safe_(d.title||'Sesion'),stamp=Utilities.formatDate(new Date(d.createdAt||new Date()),Session.getScriptTimeZone(),'yyyy-MM-dd_HH-mm'),folder=yf.createFolder(stamp+'_'+title),items=[];(d.notes||[]).forEach(n=>items.push({atMs:Number(n.atMs||0),text:'NOTA: '+(n.text||'')}));(d.markers||[]).forEach(m=>items.push({atMs:Number(m.atMs||0),text:(m.kind==='important'?'IMPORTANTE':'REVISAR')+': '+(m.label||'')}));items.sort((a,b)=>a.atMs-b.atMs);const lines=['AulaMemo AI','Sesión: '+(d.title||''),'Tipo: '+(d.type||''),'Contexto: '+(d.context||''),'Fecha: '+(d.createdAt||''),'','=== NOTAS Y MARCADORES ===','',...items.map(i=>'['+time_(i.atMs)+'] '+i.text)];if(!items.length)lines.push('Sin notas o marcadores.');const f=folder.createFile(title+'_notas.txt',lines.join('\n'),MimeType.PLAIN_TEXT);return json_({ok:true,folderId:folder.getId(),textFileId:f.getId(),fileName:f.getName()})}catch(err){return json_({ok:false,error:String(err&&err.message?err.message:err)})}}
function getFolder_(p,n){const f=p.getFoldersByName(n);return f.hasNext()?f.next():p.createFolder(n)}
function safe_(s){return String(s).replace(/[\\/:*?"<>|#%{}~&]/g,'-').trim().slice(0,80)||'Sesion'}
function time_(ms){const t=Math.max(0,Math.floor(Number(ms||0)/1000));return [Math.floor(t/3600),Math.floor(t%3600/60),t%60].map(x=>String(x).padStart(2,'0')).join(':')}
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}